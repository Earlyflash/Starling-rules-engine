# Copy to .env (already gitignored) and fill in real values.
# Never commit this file with real values in it.

# Personal Access Token from https://developer.starlingbank.com -> your
# account -> Personal Access Tokens.
#
# Needs these scopes: account:read, account-list:read, payee:read,
# transaction:read, plus pay-local:create if you intend to ever set
# dry_run: false (see starling_client.py's module docstring for a note on
# a second scope Starling's spec mentions but the portal doesn't offer).
# pay-local:create also requires a signing key - see config.example.yaml's
# signing_key_uid / signing_private_key_path comments.
STARLING_PERSONAL_ACCESS_TOKEN=

# Optional: only needed if the private key file pointed to by
# signing_private_key_path (config.yaml) is passphrase-protected.
STARLING_SIGNING_KEY_PASSPHRASE=

# Optional: a webhook URL (e.g. a Slack "Incoming Webhook") that receives a
# message for every transfer, skip, or error the engine produces. Leave
# blank to just log locally.
STARLING_RULES_ALERT_WEBHOOK_URL=
