# Copy to .env (already gitignored) and fill in real values.
# Never commit this file with real values in it.

# Personal Access Token from https://developer.starlingbank.com -> your
# account -> Personal Access Tokens.
#
# Needs at least these scopes: account:read, transaction:read (feed items),
# balance:read, payee:read, and whichever payment scope covers "pay an
# existing payee" for a Personal Access Token (Starling's docs call this
# something like "Make payments to your saved payees" in the token creation
# UI). Confirm the exact scope name against the current token-creation
# screen — this project was scaffolded without access to the live docs
# site, see README.md "Before you enable real transfers".
STARLING_PERSONAL_ACCESS_TOKEN=

# Optional: a webhook URL (e.g. a Slack "Incoming Webhook") that receives a
# message for every transfer, skip, or error the engine produces. Leave
# blank to just log locally.
STARLING_RULES_ALERT_WEBHOOK_URL=
