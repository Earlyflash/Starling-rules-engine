# Copy to .env (already gitignored) and fill in real values.
# Never commit this file with real values in it.

# Personal Access Token from https://developer.starlingbank.com -> your
# account -> Personal Access Tokens.
#
# Confirmed scopes, checked against the actual token-creation scope
# picker at developer.starlingbank.com (2026-08-22): account:read,
# account-list:read, payee:read, transaction:read, plus pay-local:create
# if you intend to ever set dry_run: false. (Starling's OpenAPI spec's
# security block for the payment endpoint also names a second scope,
# pay-local-once:create, but that isn't offered as a separate checkbox in
# the portal - nothing to do about it from here; see starling_client.py's
# module docstring.) pay-local:create also requires a signing key - see
# config.example.yaml's signing_key_uid / signing_private_key_path
# comments.
STARLING_PERSONAL_ACCESS_TOKEN=

# Optional: only needed if the private key file pointed to by
# signing_private_key_path (config.yaml) is passphrase-protected.
STARLING_SIGNING_KEY_PASSPHRASE=

# Optional: a webhook URL (e.g. a Slack "Incoming Webhook") that receives a
# message for every transfer, skip, or error the engine produces. Leave
# blank to just log locally.
STARLING_RULES_ALERT_WEBHOOK_URL=
